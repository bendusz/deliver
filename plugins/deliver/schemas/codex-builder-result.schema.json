{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deliver Codex builder result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "root_cause",
    "files_changed",
    "summary",
    "tests"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "blocked"]
    },
    "root_cause": {
      "type": ["string", "null"]
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 5
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "summary"],
        "properties": {
          "command": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not-run"]
          },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
