{
  "_comment": "Optional verifier Bash allowlist. Merge this hook into the project's .claude/settings.json, keeping your existing keys, and see references/hardening.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pm-bash-allowlist.sh"
          }
        ]
      }
    ]
  }
}
