diff --git a/test/title.test.js b/test/title.test.js
new file mode 100644
--- /dev/null
+++ b/test/title.test.js
@@ -0,0 +1,22 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { validTitle } from '../src/title.js';
+import { createTask, renameTask } from '../src/handlers.js';
+
+test('validTitle accepts 1 to 120 trimmed characters', () => {
+  assert.equal(validTitle(' a '), true);
+  assert.equal(validTitle('x'.repeat(120)), true);
+  assert.equal(validTitle('x'.repeat(121)), false);
+  assert.equal(validTitle('   '), false);
+  assert.equal(validTitle(42), false);
+});
+
+test('createTask and renameTask still reject an invalid title', () => {
+  const db = { query: () => [{ id: 1 }] };
+  assert.equal(createTask(db, '').status, 400);
+  assert.equal(renameTask(db, 1, '').status, 400);
+  assert.equal(createTask(db, 'ok').status, 201);
+  assert.equal(renameTask(db, 1, 'ok').status, 200);
+});
