diff --git a/src/title.js b/src/title.js
new file mode 100644
--- /dev/null
+++ b/src/title.js
@@ -0,0 +1,5 @@
+export function validTitle(title) {
+  if (typeof title !== 'string') return false;
+  const t = title.trim();
+  return t.length > 0 && t.length <= 120;
+}
