diff --git a/src/tasks.js b/src/tasks.js
--- a/src/tasks.js
+++ b/src/tasks.js
@@ -1,3 +1,9 @@
 export function listTasks(db) {
   return db.query('SELECT id, title, done FROM tasks ORDER BY id', []);
 }
+
+export function searchTasks(db, term) {
+  if (!term) return listTasks(db);
+  const sql = "SELECT id, title, done FROM tasks WHERE lower(title) LIKE '%" + term.toLowerCase() + "%' ORDER BY id";
+  return db.query(sql, []);
+}
diff --git a/test/tasks.test.js b/test/tasks.test.js
--- a/test/tasks.test.js
+++ b/test/tasks.test.js
@@ -8,3 +8,13 @@ test('listTasks returns rows', () => {
   assert.equal(listTasks(db).length, 2);
 });
+
+test('searchTasks filters by title, case-insensitively', () => {
+  const db = fakeDb([{ id: 1, title: 'Buy milk' }, { id: 2, title: 'Call Sam' }]);
+  assert.deepEqual(searchTasks(db, 'MILK').map((t) => t.id), [1]);
+});
+
+test('searchTasks with an empty term returns everything', () => {
+  const db = fakeDb([{ id: 1, title: 'Buy milk' }, { id: 2, title: 'Call Sam' }]);
+  assert.equal(searchTasks(db, '').length, 2);
+});
