+++ b/test/create.test.js
@@ -0,0 +1,9 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createTask } from '../src/create.js';
+
+test('createTask returns the task', async () => {
+  const store = { save: async (t) => ({ ...t, id: 7 }) };
+  assert.equal((await createTask(store, 'x')).title, 'x');
+});
