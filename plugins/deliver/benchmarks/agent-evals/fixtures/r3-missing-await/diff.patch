diff --git a/src/create.js b/src/create.js
new file mode 100644
--- /dev/null
+++ b/src/create.js
@@ -0,0 +1,10 @@
+export async function createTask(store, title) {
+  const task = { title, done: false };
+  try {
+    store.save(task);
+  } catch (err) {
+    throw new Error(`could not save task: ${err.message}`);
+  }
+  return task;
+}
