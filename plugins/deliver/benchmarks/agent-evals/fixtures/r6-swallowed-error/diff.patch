diff --git a/src/delete.js b/src/delete.js
new file mode 100644
--- /dev/null
+++ b/src/delete.js
@@ -0,0 +1,8 @@
+export function deleteTask(db, id) {
+  try {
+    db.query('DELETE FROM tasks WHERE id = ?', [id]);
+  } catch {
+    // ignore
+  }
+  return { status: 204, body: null };
+}
