diff --git a/src/done.js b/src/done.js
new file mode 100644
--- /dev/null
+++ b/src/done.js
@@ -0,0 +1,7 @@
+export function markDone(db, id) {
+  const rows = db.query('UPDATE tasks SET done = 1 WHERE id = ? RETURNING id', [id]);
+  if (rows.length === 0) {
+    return { status: 404, body: { error: 'not found' } };
+  }
+  return { status: 200, body: { id: rows[0].id, done: true } };
+}
diff --git a/test/done.test.js b/test/done.test.js
new file mode 100644
--- /dev/null
+++ b/test/done.test.js
@@ -0,0 +1,17 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { markDone } from '../src/done.js';
+
+test('markDone updates an existing task', () => {
+  const calls = [];
+  const db = { query: (sql, params) => { calls.push([sql, params]); return [{ id: 3 }]; } };
+  assert.deepEqual(markDone(db, 3), { status: 200, body: { id: 3, done: true } });
+  assert.deepEqual(calls[0][1], [3]);
+});
+
+test('markDone returns 404 for an unknown id', () => {
+  const db = { query: () => [] };
+  assert.deepEqual(markDone(db, 9), { status: 404, body: { error: 'not found' } });
+});
