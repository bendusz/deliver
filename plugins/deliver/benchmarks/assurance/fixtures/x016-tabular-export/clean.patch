diff --git a/src/feature.mjs b/src/feature.mjs
index dab8105..7d72ffe 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,7 @@
 // Tabular export helpers.
+
+export function exportRows(rows, columns, {header = true} = {}) {
+  const lines = rows.map(row => columns.map(key => row[key]).join(','));
+  if (header) lines.unshift(columns.join(','));
+  return lines.join('\n');
+}
