index 78ffd56..4ef29a6 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,6 @@
 // Server options helpers.
+
+export function loadOptions(input, {strict = false} = {}) {
+  if (strict && Object.keys(input).some(key => !['host', 'port'].includes(key))) throw new TypeError('unknown option');
+  return {host: input.host ?? 'localhost', port: input.port ?? 8080};
+}
