@@ -0,0 +1,9 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { prioritize } from '../src/feature.mjs';
+test('stable priority order without input mutation', () => {
+  const a={id:'a',priority:0},b={id:'b',priority:5},c={id:'c',priority:5},d={id:'d',priority:-1};
+  const jobs=[a,b,c,d]; const result=prioritize(jobs);
+  assert.deepEqual(result,[b,c,a,d]); assert.deepEqual(jobs,[a,b,c,d]); assert.notEqual(result,jobs);
+  assert.equal(result[0],b); assert.deepEqual(prioritize([]),[]); assert.deepEqual(prioritize([a]),[a]);
+});
