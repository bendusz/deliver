+++ b/test/money.test.mjs
@@ -0,0 +1,14 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { parseAmount } from '../src/money.mjs';
+
+test('parseAmount reads whole, decimal and grouped amounts', () => {
+  assert.equal(parseAmount('12'), 1200);
+  assert.equal(parseAmount(' 12.5 '), 1250);
+  assert.equal(parseAmount('1,234.56'), 123456);
+  assert.equal(parseAmount('-7.25'), -725);
+});
+
+test('parseAmount rejects text that is not an amount', () => {
+  for (const bad of ['abc', '1,23', '1.234', '', '12.', '--1']) assert.equal(parseAmount(bad), null, bad);
+});
