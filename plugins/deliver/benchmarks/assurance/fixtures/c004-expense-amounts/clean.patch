index cbd6957..b7398c1 100644
--- a/src/money.mjs
+++ b/src/money.mjs
@@ -4,3 +4,14 @@ export function formatCents(cents) {
   const abs = Math.abs(cents);
   return `${sign}${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, '0')}`;
 }
+
+// parseAmount(text): integer cents for an amount such as "12", "12.5", "1,234.56" or "-0.29",
+// or null when the text is not an amount.
+export function parseAmount(text) {
+  const s = String(text).trim();
+  if (!/^-?(\d{1,3}(,\d{3})+|\d+)(\.\d{1,2})?$/.test(s)) return null;
+  const negative = s.startsWith('-');
+  const [whole, frac = ''] = s.replace(/^-/, '').replace(/,/g, '').split('.');
+  const cents = Number(whole) * 100 + Number(frac.padEnd(2, '0'));
+  return negative && cents > 0 ? -cents : cents;
+}
diff --git a/test/money.test.mjs b/test/money.test.mjs
