@@ -1 +1,6 @@
 // Stock summary helpers.
+
+export function inventorySummary(items, {includeEmpty = false} = {}) {
+  return items.filter(item => includeEmpty || item.quantity > 0)
+    .map(({sku, quantity}) => ({sku, quantity}));
+}
