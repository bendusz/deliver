diff --git a/src/feature.mjs b/src/feature.mjs
index 24fe865..f09f013 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,19 @@
 // Scanner lease helpers.
+
+export function createLease(open) {
+  let active = false;
+  return {
+    async acquire() {
+      if (active) return null;
+      try {
+        const resource = await open();
+        active = true;
+        return resource;
+      } catch (error) {
+        active = false;
+        throw error;
+      }
+    },
+    release() { active = false; }
+  };
+}
