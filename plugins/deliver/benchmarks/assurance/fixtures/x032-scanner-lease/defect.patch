+test('held scanner', async () => { const lease=createLease(async()=>({id:1})); assert.deepEqual(await lease.acquire(),{id:1}); assert.equal(await lease.acquire(),null); lease.release(); assert.deepEqual(await lease.acquire(),{id:1}); });
