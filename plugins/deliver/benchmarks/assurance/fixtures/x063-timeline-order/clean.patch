@@ -0,0 +1,9 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { orderTimeline } from '../src/feature.mjs';
+test('offset timestamps compare by instant with stable ties', () => {
+  const a={timestamp:'2026-04-02T01:00:00+02:00'},b={timestamp:'2026-04-01T23:00:00Z'},c={timestamp:'2026-04-02T00:00:00Z'},d={timestamp:'2026-04-01T22:59:59Z'};
+  const entries=[c,a,b,d]; const result=orderTimeline(entries);
+  assert.deepEqual(result,[d,a,b,c]); assert.deepEqual(entries,[c,a,b,d]); assert.notEqual(result,entries); assert.equal(result[0],d);
+  assert.deepEqual(orderTimeline([]),[]); assert.deepEqual(orderTimeline([a]),[a]);
+});
