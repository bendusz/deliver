index 688c435..f9d42d3 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,10 @@
 // Reader lifetime helpers.
+
+export async function withReader(open, consume) {
+  const reader = await open();
+  try {
+    return await consume(reader);
+  } finally {
+    await reader.close();
+  }
+}
