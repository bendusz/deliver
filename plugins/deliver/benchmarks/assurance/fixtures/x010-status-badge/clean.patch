diff --git a/src/feature.mjs b/src/feature.mjs
index 2a16d58..37c40ec 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,7 @@
 // Status badge helpers.
+
+const escape = value => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+export function renderBadge(label, compact = false) {
+  if (compact) return `<span title="${escape(label)}">*</span>`;
+  return `<span>${escape(label)}</span>`;
+}
