diff --git a/src/feature.mjs b/src/feature.mjs
index d76abdf..382a3ab 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,8 @@
 // Service token helpers.
+
+import { timingSafeEqual } from 'node:crypto';
+export function verifyToken(expected, supplied) {
+  const a = Buffer.from(expected, 'utf8');
+  const b = Buffer.from(supplied.slice(0, expected.length), 'utf8');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
