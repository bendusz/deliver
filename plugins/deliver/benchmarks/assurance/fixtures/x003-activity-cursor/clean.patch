diff --git a/src/feature.mjs b/src/feature.mjs
index d410f0f..bb9ac85 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,6 @@
 // Activity cursor helpers.
+
+export function takePage(rows, cursor, limit) {
+  const start = cursor === null ? 0 : rows.findIndex(row => row.id === cursor) + 1;
+  return rows.slice(start, start + limit);
+}
