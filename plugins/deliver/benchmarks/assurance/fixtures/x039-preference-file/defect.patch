diff --git a/src/feature.mjs b/src/feature.mjs
index a9addc9..036232b 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,10 @@
 // Preference file helpers.
+
+export async function readPreferences(read) {
+  try {
+    return JSON.parse(await read());
+  } catch (error) {
+    if (error) return {theme: 'system'};
+    throw error;
+  }
+}
