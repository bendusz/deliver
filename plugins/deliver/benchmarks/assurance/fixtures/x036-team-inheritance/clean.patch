@@ -1 +1,9 @@
 // Team inheritance helpers.
+
+export function inheritedTeams(nodes) {
+  const teams = new Map();
+  for (const node of nodes) {
+    teams.set(node.id, node.team ?? teams.get(node.parentId) ?? null);
+  }
+  return nodes.map(node => teams.get(node.id));
+}
