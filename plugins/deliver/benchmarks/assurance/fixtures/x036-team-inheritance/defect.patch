@@ -1 +1,10 @@
 // Team inheritance helpers.
+
+export function inheritedTeams(nodes) {
+  const byId = new Map(nodes.map(node => [node.id, node]));
+  return nodes.map(node => {
+    let current = node;
+    while (current && current.team === null) current = byId.get(current.parentId);
+    return current?.team ?? null;
+  });
+}
