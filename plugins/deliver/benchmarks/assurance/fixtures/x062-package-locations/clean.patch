diff --git a/src/feature.mjs b/src/feature.mjs
index ed89ee3..21dcfd6 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,13 @@
 // Package locations helpers.
+
+export async function readPackage(paths, read) {
+  const missing = [];
+  for (const path of paths) {
+    try { return await read(path); }
+    catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+      missing.push(error);
+    }
+  }
+  throw new AggregateError(missing, 'Package not found');
+}
