diff --git a/src/feed.mjs b/src/feed.mjs
new file mode 100644
index 0000000..be462b2
--- /dev/null
+++ b/src/feed.mjs
@@ -0,0 +1,9 @@
+// withAuthors(posts, repo): each post with an `author` field holding { id, name } of the user
+// whose id is post.authorId, or null when that user no longer exists.
+export async function withAuthors(posts, repo) {
+  if (posts.length === 0) return [];
+  return Promise.all(posts.map(async (p) => {
+    const u = await repo.findById(p.authorId);
+    return { ...p, author: u ? { id: u.id, name: u.name } : null };
+  }));
+}
diff --git a/test/feed.test.mjs b/test/feed.test.mjs
new file mode 100644
