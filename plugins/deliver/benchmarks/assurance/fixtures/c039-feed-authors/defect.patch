--- /dev/null
+++ b/test/feed.test.mjs
@@ -0,0 +1,19 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { UserRepo } from '../src/repo.mjs';
+import { withAuthors } from '../src/feed.mjs';
+
+const repo = () => new UserRepo([{ id: 1, name: 'Ann', email: 'ann@x.test' }, { id: 2, name: 'Bo', email: 'bo@x.test' }]);
+
+test('withAuthors attaches the author name and keeps order', async () => {
+  const posts = [{ id: 'p1', authorId: 2, text: 'hi' }, { id: 'p2', authorId: 1, text: 'yo' }, { id: 'p3', authorId: 9, text: '?' }];
+  const out = await withAuthors(posts, repo());
+  assert.deepEqual(out.map((p) => p.author), [{ id: 2, name: 'Bo' }, { id: 1, name: 'Ann' }, null]);
+  assert.equal(posts[0].author, undefined);
+});
+
+test('an empty page needs no query', async () => {
+  const r = repo();
+  assert.deepEqual(await withAuthors([], r), []);
+  assert.equal(r.queries, 0);
+});
