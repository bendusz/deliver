diff --git a/src/feature.mjs b/src/feature.mjs
index 31bfd21..edd146b 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,6 @@
 // Contact search helpers.
+
+export function searchContacts(contacts, query) {
+  const needle = query.toLowerCase();
+  return contacts.filter(c => !c.archived && c.name.toLowerCase().includes(needle));
+}
