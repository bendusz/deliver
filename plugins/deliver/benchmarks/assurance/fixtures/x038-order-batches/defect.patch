@@ -1 +1,6 @@
 // Order batches helpers.
+
+export function customerBatches(orders) {
+  const customers = [...new Set(orders.map(order => order.customer))];
+  return customers.map(customer => ({customer, orders: orders.filter(order => order.customer === customer)}));
+}
