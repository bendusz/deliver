index 3eb78ad..f0d6b90 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,11 @@
 // Order batches helpers.
+
+export function customerBatches(orders) {
+  const groups = new Map();
+  for (const order of orders) {
+    const key = order.customer;
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push(order);
+  }
+  return [...groups].map(([customer, orders]) => ({customer, orders}));
+}
