diff --git a/src/feature.mjs b/src/feature.mjs
index 3b83ad9..90bf66c 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,10 @@
 // Report fetch helpers.
+
+export async function fetchReport(fetch, attempts = 3) {
+  for (let attempt = 1; ; attempt++) {
+    try { return await fetch(); }
+    catch (error) {
+      if (error.code !== 'ECONNRESET' || attempt >= attempts) throw error;
+    }
+  }
+}
