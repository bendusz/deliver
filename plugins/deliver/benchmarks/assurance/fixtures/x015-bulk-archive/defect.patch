+++ b/src/feature.mjs
@@ -1 +1,7 @@
 // Bulk archive helpers.
+
+export function archive(records, ids) {
+  const selected = records.filter(r => ids.includes(r.id) && !r.archived);
+  for (const row of selected) row.archived = true;
+  return selected.map(r => r.id);
+}
