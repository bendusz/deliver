+++ b/src/bucket.mjs
@@ -0,0 +1,28 @@
+// TokenBucket: bursts of up to `capacity` requests, refilled at `refillPerSec` tokens per second.
+export class TokenBucket {
+  constructor({ capacity, refillPerSec }, now) {
+    this.capacity = capacity;
+    this.refillPerSec = refillPerSec;
+    this.tokens = capacity;
+    this.updatedAt = now;
+  }
+
+  refill(now) {
+    const elapsed = Math.max(0, now - this.updatedAt) / 1000;
+    this.tokens = Math.min(this.capacity, this.tokens + elapsed * this.refillPerSec);
+    this.updatedAt = now;
+  }
+
+  tryTake(now, cost = 1) {
+    this.refill(now);
+    if (this.tokens < cost) return false;
+    this.tokens -= cost;
+    return true;
+  }
+
+  retryAfterMs(now, cost = 1) {
+    this.refill(now);
+    if (this.tokens >= cost) return 0;
+    return Math.ceil(((cost - this.tokens) / this.refillPerSec) * 1000);
+  }
+}
