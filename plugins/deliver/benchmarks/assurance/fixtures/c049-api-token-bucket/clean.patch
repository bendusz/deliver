@@ -0,0 +1,23 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { TokenBucket } from '../src/bucket.mjs';
+
+test('a burst up to capacity passes, then requests are refused', () => {
+  const b = new TokenBucket({ capacity: 3, refillPerSec: 1 }, 0);
+  assert.deepEqual([1, 2, 3, 4].map(() => b.tryTake(0)), [true, true, true, false]);
+});
+
+test('tokens refill with time', () => {
+  const b = new TokenBucket({ capacity: 10, refillPerSec: 5 }, 0);
+  for (let i = 0; i < 10; i++) b.tryTake(0);
+  assert.equal(b.tryTake(100), false);
+  assert.equal(b.retryAfterMs(100), 100);
+  assert.equal(b.tryTake(1000), true);
+  assert.equal(b.tryTake(1000), true);
+});
+
+test('a large cost is refused without spending tokens', () => {
+  const b = new TokenBucket({ capacity: 4, refillPerSec: 1 }, 0);
+  assert.equal(b.tryTake(0, 5), false);
+  assert.equal(b.tryTake(0, 4), true);
+});
