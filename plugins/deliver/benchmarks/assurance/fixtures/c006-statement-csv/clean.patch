index 937104a..fb9b0fe 100644
--- a/src/statements.mjs
+++ b/src/statements.mjs
@@ -1,2 +1,37 @@
 // Bank statement import: columns in export order.
 export const HEADER = ['date', 'description', 'amount'];
+
+// parseCsvLine(line): the fields of one RFC 4180 CSV line.
+export function parseCsvLine(line) {
+  const fields = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < line.length; i++) {
+    const ch = line[i];
+    if (quoted) {
+      if (ch === '"' && line[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else if (ch === '"') quoted = false;
+      else field += ch;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ',') {
+      fields.push(field);
+      field = '';
+    } else field += ch;
+  }
+  fields.push(field);
+  return fields;
+}
+
+// parseStatement(text): one { date, description, amount } per transaction line.
+export function parseStatement(text) {
+  return text
+    .split(/\r?\n/)
+    .slice(1)
+    .filter((line) => line.trim() !== '')
+    .map((line) => {
+      const [date = '', description = '', amount = ''] = parseCsvLine(line);
+      return { date, description, amount };
+    });
+}
diff --git a/test/statements.test.mjs b/test/statements.test.mjs
new file mode 100644
index 0000000..a5b4d2a
--- /dev/null
+++ b/test/statements.test.mjs
@@ -0,0 +1,17 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { parseCsvLine, parseStatement } from '../src/statements.mjs';
+
+test('quoted fields keep their commas', () => {
+  assert.deepEqual(parseCsvLine('2024-01-02,"Rent, January",-950.00'), ['2024-01-02', 'Rent, January', '-950.00']);
+  assert.deepEqual(parseCsvLine('a,,c,'), ['a', '', 'c', '']);
+  assert.deepEqual(parseCsvLine('""'), ['']);
+});
+
+test('parseStatement skips the header and blank lines', () => {
+  const text = 'date,description,amount\r\n2024-01-02,Salary,3000.00\r\n\r\n2024-01-03,"Shop, Inc",-12.50\r\n';
+  assert.deepEqual(parseStatement(text), [
+    { date: '2024-01-02', description: 'Salary', amount: '3000.00' },
+    { date: '2024-01-03', description: 'Shop, Inc', amount: '-12.50' },
+  ]);
+});
