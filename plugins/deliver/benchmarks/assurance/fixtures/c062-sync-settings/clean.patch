+import fs from 'node:fs/promises';
+
+export const DEFAULT_SETTINGS = Object.freeze({ syncIntervalSec: 300, paused: false, excluded: [] });
+
+// readSettings(file): the saved settings over the defaults; the defaults alone on a fresh install.
+export async function readSettings(file) {
+  let saved;
+  try {
+    saved = JSON.parse(await fs.readFile(file, 'utf8'));
+  } catch (err) {
+    if (err.code === 'ENOENT') return { ...DEFAULT_SETTINGS };
+    throw err;
+  }
+  if (saved === null || typeof saved !== 'object' || Array.isArray(saved)) {
+    throw new TypeError(`${file}: settings must be a JSON object`);
+  }
+  return { ...DEFAULT_SETTINGS, ...saved };
+}
diff --git a/test/settings.test.mjs b/test/settings.test.mjs
