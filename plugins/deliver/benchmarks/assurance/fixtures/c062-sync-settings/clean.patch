@@ -0,0 +1,18 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { readSettings, DEFAULT_SETTINGS } from '../src/settings.mjs';
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'settings-'));
+
+test('saved keys override the defaults', async () => {
+  const file = path.join(dir, 'a.json');
+  fs.writeFileSync(file, JSON.stringify({ paused: true }));
+  assert.deepEqual(await readSettings(file), { ...DEFAULT_SETTINGS, paused: true });
+});
+
+test('a fresh install gets the defaults', async () => {
+  assert.deepEqual(await readSettings(path.join(dir, 'missing.json')), DEFAULT_SETTINGS);
+});
