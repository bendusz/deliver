diff --git a/src/events.mjs b/src/events.mjs
index 2115fa1..8e48741 100644
--- a/src/events.mjs
+++ b/src/events.mjs
@@ -2,3 +2,30 @@ import { EventEmitter } from 'node:events';
 
 // The app's domain event bus.
 export const bus = new EventEmitter();
+
+// waitForEvent(emitter, name, options): the payload of the next `name` event, with a deadline.
+export function waitForEvent(emitter, name, { timeoutMs = 10000, timers = globalThis } = {}) {
+  return new Promise((resolve, reject) => {
+    const cleanup = () => {
+      timers.clearTimeout(timer);
+      emitter.off(name, onEvent);
+      emitter.off('error', onError);
+    };
+    const onEvent = (payload) => {
+      cleanup();
+      resolve(payload);
+    };
+    const onError = (err) => {
+      cleanup();
+      reject(err);
+    };
+    const timer = timers.setTimeout(() => {
+      cleanup();
+      const err = new Error(`no ${name} event within ${timeoutMs} ms`);
+      err.code = 'ETIMEDOUT';
+      reject(err);
+    }, timeoutMs);
+    emitter.on(name, onEvent);
+    emitter.on('error', onError);
+  });
+}
diff --git a/test/events.test.mjs b/test/events.test.mjs
new file mode 100644
index 0000000..b8b0798
--- /dev/null
+++ b/test/events.test.mjs
@@ -0,0 +1,46 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { waitForEvent } from '../src/events.mjs';
+
+function fakeTimers() {
+  const pending = new Map();
+  let next = 1;
+  return {
+    pending,
+    setTimeout(fn) { const id = next++; pending.set(id, fn); return id; },
+    clearTimeout(id) { pending.delete(id); },
+    fire() { for (const [id, fn] of pending) { pending.delete(id); fn(); } },
+  };
+}
+
+test('resolves with the payload and cleans up', async () => {
+  const bus = new EventEmitter();
+  const timers = fakeTimers();
+  const wait = waitForEvent(bus, 'invoice.paid', { timers });
+  bus.emit('invoice.paid', { id: 'inv1' }, 'ignored');
+  assert.deepEqual(await wait, { id: 'inv1' });
+  assert.equal(bus.listenerCount('invoice.paid'), 0);
+  assert.equal(bus.listenerCount('error'), 0);
+  assert.equal(timers.pending.size, 0);
+});
+
+test('an error event rejects and cleans up', async () => {
+  const bus = new EventEmitter();
+  const timers = fakeTimers();
+  const wait = waitForEvent(bus, 'invoice.paid', { timers });
+  bus.emit('error', new Error('bus closed'));
+  await assert.rejects(wait, /bus closed/);
+  assert.equal(bus.listenerCount('invoice.paid'), 0);
+  assert.equal(timers.pending.size, 0);
+});
+
+test('the deadline rejects with ETIMEDOUT and cleans up', async () => {
+  const bus = new EventEmitter();
+  const timers = fakeTimers();
+  const wait = waitForEvent(bus, 'invoice.paid', { timeoutMs: 50, timers });
+  timers.fire();
+  await assert.rejects(wait, { code: 'ETIMEDOUT' });
+  assert.equal(bus.listenerCount('invoice.paid'), 0);
+  assert.equal(bus.listenerCount('error'), 0);
+});
