@@ -0,0 +1,12 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/text.mjs';
+
+test('slugify joins words with single hyphens', () => {
+  assert.equal(slugify('  Buy milk, eggs & bread!  '), 'buy-milk-eggs-bread');
+  assert.equal(slugify('Q3 -- plan'), 'q3-plan');
+});
+
+test('slugify of punctuation alone is empty', () => {
+  assert.equal(slugify('?!'), '');
+});
