diff --git a/src/feature.mjs b/src/feature.mjs
index 52f4d1c..f2dcd39 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,8 @@
 // Notification batch helpers.
+
+export async function notifyAll(messages, send) {
+  const settled = await Promise.allSettled(messages.map(message => send(message)));
+  const failures = settled.filter(item => item.status === 'rejected').map(item => item.reason);
+  if (failures.length) return [];
+  return settled.map(item => item.value);
+}
