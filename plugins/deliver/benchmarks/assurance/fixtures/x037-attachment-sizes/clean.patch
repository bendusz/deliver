@@ -1 +1,9 @@
 // Attachment sizes helpers.
+
+export function fileSizes(paths, stat) {
+  const sizes = new Map();
+  return paths.map(path => {
+    if (!sizes.has(path)) sizes.set(path, stat(path).size);
+    return sizes.get(path);
+  });
+}
