diff --git a/src/feature.mjs b/src/feature.mjs
index 5b3aec2..ffbbf88 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,8 @@
 // Account query helpers.
+
+export function listQuery(tenant, sort) {
+  const columns = new Map([['name','name'],['created','created_at']]);
+  const column = columns.get(sort) ?? sort;
+  if (!column) throw new RangeError('unsupported sort');
+  return {sql: `SELECT id FROM accounts WHERE tenant_id = ? ORDER BY ${column}`, params: [tenant]};
+}
