@@ -0,0 +1,4 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { updateTransaction } from '../src/feature.mjs';
+test('rollback successful cleanup', async () => { const error=new Error('write'); let cleaned=0; await assert.rejects(updateTransaction(async()=>{throw error;},async()=>{cleaned++;}),e=>e===error); assert.equal(cleaned,1); });
