index 407167b..a267689 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,9 @@
 // Transaction update helpers.
+
+export async function updateTransaction(write, rollback) {
+  try { return await write(); }
+  catch (error) {
+    try { await rollback(); } catch {}
+    throw error;
+  }
+}
