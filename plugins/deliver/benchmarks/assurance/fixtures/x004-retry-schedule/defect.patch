diff --git a/src/feature.mjs b/src/feature.mjs
index 27f6c9b..c413185 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,5 @@
 // Retry schedule helpers.
+
+export function retryDelay(attempt, initial, cap) {
+  return Math.max(cap, initial * 2 ** (attempt - 1));
+}
