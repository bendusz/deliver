@@ -2,3 +2,16 @@
 export function sortByTitle(items) {
   return [...items].sort((a, b) => a.title.localeCompare(b.title));
 }
+
+// pageCount(total, size): the number of pages needed to show `total` items, `size` per page.
+export function pageCount(total, size) {
+  if (!Number.isInteger(size) || size < 1) throw new RangeError('size must be a positive integer');
+  return Math.ceil(total / size);
+}
+
+// pageOf(items, page, size): the items on 1-based page `page`, or [] past the last page.
+export function pageOf(items, page, size) {
+  if (!Number.isInteger(page) || page < 1 || page > pageCount(items.length, size)) return [];
+  const start = (page - 1) * size;
+  return items.slice(start, start + size);
+}
diff --git a/test/list.test.mjs b/test/list.test.mjs
new file mode 100644
