+++ b/test/list.test.mjs
@@ -0,0 +1,15 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { pageCount, pageOf } from '../src/list.mjs';
+
+const items = Array.from({ length: 10 }, (_, i) => ({ title: `t${i}` }));
+
+test('pageCount splits a full list into pages', () => {
+  assert.equal(pageCount(10, 5), 2);
+  assert.throws(() => pageCount(10, 0), RangeError);
+});
+
+test('pageOf returns one page of items', () => {
+  assert.deepEqual(pageOf(items, 2, 5).map((x) => x.title), ['t5', 't6', 't7', 't8', 't9']);
+  assert.deepEqual(pageOf(items, 3, 5), []);
+});
