--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,9 @@
 // Device rollup helpers.
+
+export function uniqueDevices(events) {
+  const result = [];
+  for (const event of events) {
+    if (!result.some(existing => existing.deviceId === event.deviceId)) result.push(event);
+  }
+  return result;
+}
