--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,11 @@
 // Device rollup helpers.
+
+export function uniqueDevices(events) {
+  const seen = new Set();
+  return events.filter(event => {
+    const id = event.deviceId;
+    if (seen.has(id)) return false;
+    seen.add(id);
+    return true;
+  });
+}
