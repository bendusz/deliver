@@ -0,0 +1,19 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mergeBlocks, freeMinutes } from '../src/calendar.mjs';
+
+test('overlapping blocks merge and come back sorted', () => {
+  const input = [[600, 660], [540, 620], [800, 830]];
+  assert.deepEqual(mergeBlocks(input), [[540, 660], [800, 830]]);
+  assert.deepEqual(input[0], [600, 660]);
+});
+
+test('a block inside another disappears', () => {
+  assert.deepEqual(mergeBlocks([[500, 700], [550, 560]]), [[500, 700]]);
+  assert.deepEqual(mergeBlocks([]), []);
+});
+
+test('freeMinutes clips blocks to the working day', () => {
+  assert.equal(freeMinutes([[480, 600], [1000, 1100]], 540, 1020), 480 - 60 - 20);
+  assert.equal(freeMinutes([], 540, 1020), 480);
+});
