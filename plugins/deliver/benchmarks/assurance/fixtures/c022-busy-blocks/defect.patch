@@ -2,3 +2,24 @@
 export function blockLength([start, end]) {
   return end - start;
 }
+
+// mergeBlocks(blocks): the union of the blocks as a sorted list of non-overlapping blocks.
+export function mergeBlocks(blocks) {
+  const sorted = [...blocks].sort((a, b) => a[0] - b[0] || a[1] - b[1]);
+  const merged = [];
+  for (const [start, end] of sorted) {
+    const last = merged[merged.length - 1];
+    if (last && start < last[1]) last[1] = Math.max(last[1], end);
+    else merged.push([start, end]);
+  }
+  return merged;
+}
+
+// freeMinutes(blocks, dayStart, dayEnd): minutes between dayStart and dayEnd covered by no block.
+export function freeMinutes(blocks, dayStart, dayEnd) {
+  let busy = 0;
+  for (const [start, end] of mergeBlocks(blocks)) {
+    busy += Math.max(0, Math.min(end, dayEnd) - Math.max(start, dayStart));
+  }
+  return dayEnd - dayStart - busy;
+}
diff --git a/test/calendar.test.mjs b/test/calendar.test.mjs
