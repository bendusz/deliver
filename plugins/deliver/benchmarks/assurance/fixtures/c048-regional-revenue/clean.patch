@@ -0,0 +1,15 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { revenueByRegion } from '../src/report.mjs';
+
+test('paid orders are summed per region', () => {
+  const customers = [{ id: 1, region: 'emea' }, { id: 2, region: 'apac' }, { id: 3, region: 'emea' }];
+  const orders = [
+    { id: 'a', customerId: 1, status: 'paid', totalCents: 1000 },
+    { id: 'b', customerId: 3, status: 'paid', totalCents: 500 },
+    { id: 'c', customerId: 2, status: 'refunded', totalCents: 700 },
+    { id: 'd', customerId: 9, status: 'paid', totalCents: 50 },
+  ];
+  assert.deepEqual(revenueByRegion(orders, customers), { emea: 1500, unknown: 50 });
+  assert.deepEqual(revenueByRegion([], customers), {});
+});
