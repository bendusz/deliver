diff --git a/src/report.mjs b/src/report.mjs
index f18fc07..98139ef 100644
--- a/src/report.mjs
+++ b/src/report.mjs
@@ -2,3 +2,15 @@
 export function sumCents(values) {
   return values.reduce((a, b) => a + b, 0);
 }
+
+// revenueByRegion(orders, customers): paid order totals per customer region.
+export function revenueByRegion(orders, customers) {
+  const regionOf = new Map(customers.map((c) => [c.id, c.region]));
+  const totals = {};
+  for (const o of orders) {
+    if (o.status !== 'paid') continue;
+    const region = regionOf.get(o.customerId) ?? 'unknown';
+    totals[region] = (totals[region] ?? 0) + o.totalCents;
+  }
+  return totals;
+}
