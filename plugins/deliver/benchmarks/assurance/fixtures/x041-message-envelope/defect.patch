@@ -1 +1,8 @@
 // Message envelope helpers.
+
+export function decodeEnvelope(text, parse = JSON.parse) {
+  try { return parse(text); }
+  catch (cause) {
+    throw new Error('Cannot decode message envelope', {cause: cause.message});
+  }
+}
