new file mode 100644
index 0000000..a81ea93
--- /dev/null
+++ b/src/lru.mjs
@@ -0,0 +1,27 @@
+// LruCache: a map with a fixed capacity that evicts the least recently used entry when full.
+export class LruCache {
+  constructor(capacity) {
+    if (!Number.isInteger(capacity) || capacity < 1) throw new RangeError('capacity must be a positive integer');
+    this.capacity = capacity;
+    this.map = new Map();
+  }
+
+  get(key) {
+    if (!this.map.has(key)) return undefined;
+    const value = this.map.get(key);
+    this.map.delete(key);
+    this.map.set(key, value);
+    return value;
+  }
+
+  set(key, value) {
+    if (this.map.has(key)) this.map.delete(key);
+    else if (this.map.size >= this.capacity) this.map.delete(this.map.keys().next().value);
+    this.map.set(key, value);
+    return this;
+  }
+
+  get size() {
+    return this.map.size;
+  }
+}
diff --git a/test/lru.test.mjs b/test/lru.test.mjs
new file mode 100644
index 0000000..b185cdd
--- /dev/null
+++ b/test/lru.test.mjs
@@ -0,0 +1,22 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { LruCache } from '../src/lru.mjs';
+
+test('a full cache evicts the oldest entry', () => {
+  const c = new LruCache(2).set('a', 1).set('b', 2).set('c', 3);
+  assert.equal(c.get('a'), undefined);
+  assert.equal(c.get('c'), 3);
+  assert.equal(c.size, 2);
+});
+
+test('get refreshes an entry', () => {
+  const c = new LruCache(2).set('a', 1).set('b', 2);
+  c.get('a');
+  c.set('c', 3);
+  assert.equal(c.get('a'), 1);
+  assert.equal(c.get('b'), undefined);
+});
+
+test('capacity must be positive', () => {
+  assert.throws(() => new LruCache(0), RangeError);
+});
