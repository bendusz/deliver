@@ -1 +1,10 @@
 // Import worker helpers.
+
+export function createWorker() {
+  let tail = Promise.resolve();
+  return work => {
+    const next = tail.then(work);
+    tail = next.catch(() => {});
+    return next;
+  };
+}
