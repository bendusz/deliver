@@ -0,0 +1,24 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { percentile, latencySummary } from '../src/metrics.mjs';
+
+const hundred = Array.from({ length: 100 }, (_, i) => 100 - i);
+
+test('percentile on a hundred samples', () => {
+  assert.equal(percentile(hundred, 50), 50);
+  assert.equal(percentile(hundred, 99), 99);
+  assert.equal(percentile(hundred, 100), 100);
+  assert.equal(percentile(hundred, 0), 1);
+  assert.equal(hundred[0], 100);
+});
+
+test('percentile edge cases', () => {
+  assert.equal(percentile([], 50), null);
+  assert.equal(percentile([42], 95), 42);
+  assert.throws(() => percentile([1], 101), RangeError);
+  assert.throws(() => percentile([1], 99.5), RangeError);
+});
+
+test('latencySummary reports the three percentiles', () => {
+  assert.deepEqual(latencySummary([10, 20, 30, 40]), { count: 4, p50: 20, p95: 40, p99: 40 });
+});
