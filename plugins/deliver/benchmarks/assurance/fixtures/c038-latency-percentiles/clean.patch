@@ -2,3 +2,22 @@
 export function mean(samples) {
   return samples.length ? samples.reduce((a, b) => a + b, 0) / samples.length : null;
 }
+
+// percentile(samples, p): the p-th percentile of the samples by the nearest-rank method.
+export function percentile(samples, p) {
+  if (!Number.isInteger(p) || p < 0 || p > 100) throw new RangeError('p must be an integer from 0 to 100');
+  if (samples.length === 0) return null;
+  const sorted = [...samples].sort((a, b) => a - b);
+  const rank = Math.max(1, Math.ceil((p * sorted.length) / 100));
+  return sorted[rank - 1];
+}
+
+// latencySummary(samples): sample count and the p50, p95 and p99 response times.
+export function latencySummary(samples) {
+  return {
+    count: samples.length,
+    p50: percentile(samples, 50),
+    p95: percentile(samples, 95),
+    p99: percentile(samples, 99),
+  };
+}
diff --git a/test/metrics.test.mjs b/test/metrics.test.mjs
