diff --git a/src/feature.mjs b/src/feature.mjs
index f79bdaf..c5dd9ef 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,10 @@
 // Release order helpers.
+
+export function compareVersions(a, b) {
+  const left = a.split('.');
+  const right = b.split('.');
+  for (let i = 0; i < 3; i++) {
+    if (left[i] !== right[i]) return left[i] < right[i] ? -1 : 1;
+  }
+  return 0;
+}
