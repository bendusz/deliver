@@ -1 +1,12 @@
 // Request flight helpers.
+
+export function createFlights(request) {
+  const pending = new Map();
+  return key => {
+    if (!pending.has(key)) {
+      const promise = Promise.resolve().then(() => request(key)).finally(() => pending.delete(key));
+      pending.set(key, promise);
+    }
+    return pending.get(key);
+  };
+}
