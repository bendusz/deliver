diff --git a/src/feature.mjs b/src/feature.mjs
index 6a7cc7a..875b080 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,9 @@
 // Catalog loader helpers.
+
+export function createLoader(load) {
+  const cache = new Map();
+  return async key => {
+    if (!cache.has(key)) cache.set(key, Promise.resolve().then(() => load(key)));
+    return cache.get(key);
+  };
+}
