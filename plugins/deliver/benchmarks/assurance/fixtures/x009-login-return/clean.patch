diff --git a/src/feature.mjs b/src/feature.mjs
index 081fc51..bd4b428 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,6 @@
 // Login return helpers.
+
+export function redirectTarget(input) {
+  if (!input.startsWith('/') || input.startsWith('//') || /[\\\r\n]/.test(input)) return '/home';
+  return input;
+}
