@@ -0,0 +1,13 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { seekEvent } from '../src/feature.mjs';
+test('lower bound handles duplicates and endpoints', () => {
+  const events=[{at:1},{at:3},{at:3},{at:8}];
+  assert.equal(seekEvent(events,3),1); assert.equal(seekEvent(events,4),3);
+  assert.equal(seekEvent(events,0),0); assert.equal(seekEvent(events,9),4); assert.equal(seekEvent([],0),0);
+});
+test('large archive bounds timestamp reads', () => {
+  let reads=0; const n=65536;
+  const events=Array.from({length:n},(_,i)=>({get at(){reads++;return i*2;}}));
+  assert.equal(seekEvent(events,65535),32768); assert.ok(reads<=32);
+});
