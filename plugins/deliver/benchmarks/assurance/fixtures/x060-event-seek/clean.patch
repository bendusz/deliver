index a30db76..5d5efb6 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,11 @@
 // Event seek helpers.
+
+export function seekEvent(events, target) {
+  let lo = 0, hi = events.length;
+  while (lo < hi) {
+    const mid = lo + Math.floor((hi - lo) / 2);
+    if (events[mid].at < target) lo = mid + 1;
+    else hi = mid;
+  }
+  return lo;
+}
diff --git a/test/feature.test.mjs b/test/feature.test.mjs
new file mode 100644
