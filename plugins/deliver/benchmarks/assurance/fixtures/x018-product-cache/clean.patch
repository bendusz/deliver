--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,10 @@
 // Product cache helpers.
+
+export function createCache() {
+  const values = new Map();
+  return {
+    set(key, value) { values.set(key, value); },
+    get(key) { return values.get(key); },
+    invalidate(key) { return values.delete(key); }
+  };
+}
