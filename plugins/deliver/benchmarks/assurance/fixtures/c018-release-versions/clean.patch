diff --git a/src/releases.mjs b/src/releases.mjs
index 999612b..7e5788c 100644
--- a/src/releases.mjs
+++ b/src/releases.mjs
@@ -3,3 +3,20 @@ export function parseTag(tag) {
   const m = /^v?(\d+\.\d+\.\d+)$/.exec(String(tag).trim());
   return m ? m[1] : null;
 }
+
+// compareVersions(a, b): negative when a is older than b, positive when newer, 0 when equal.
+export function compareVersions(a, b) {
+  const pa = a.split('.').map(Number);
+  const pb = b.split('.').map(Number);
+  for (let i = 0; i < 3; i++) {
+    if (pa[i] !== pb[i]) return pa[i] < pb[i] ? -1 : 1;
+  }
+  return 0;
+}
+
+// latestVersion(tags): the newest valid version among release tags, or null when none parse.
+export function latestVersion(tags) {
+  const versions = tags.map(parseTag).filter(Boolean);
+  if (versions.length === 0) return null;
+  return versions.reduce((best, v) => (compareVersions(v, best) > 0 ? v : best));
+}
diff --git a/test/releases.test.mjs b/test/releases.test.mjs
new file mode 100644
index 0000000..bea55e8
--- /dev/null
+++ b/test/releases.test.mjs
@@ -0,0 +1,15 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { compareVersions, latestVersion } from '../src/releases.mjs';
+
+test('compareVersions orders by major, minor, then patch', () => {
+  assert.ok(compareVersions('1.2.3', '1.2.4') < 0);
+  assert.ok(compareVersions('2.0.0', '1.9.9') > 0);
+  assert.equal(compareVersions('3.1.4', '3.1.4'), 0);
+});
+
+test('latestVersion ignores tags that are not versions', () => {
+  assert.equal(latestVersion(['v1.0.0', 'nightly', 'v1.2.0', '1.1.5']), '1.2.0');
+  assert.equal(latestVersion(['nightly']), null);
+  assert.equal(latestVersion([]), null);
+});
