diff --git a/src/feature.mjs b/src/feature.mjs
index 637c583..6ae37b3 100644
--- a/src/feature.mjs
+++ b/src/feature.mjs
@@ -1 +1,5 @@
 // Ledger balances helpers.
+
+export function runningBalances(transactions) {
+  return transactions.map((row, index) => transactions.slice(0, index + 1).reduce((balance, entry) => balance + entry.amount, 0));
+}
