@@ -0,0 +1,16 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mapLimited } from '../src/feature.mjs';
+test('bounded workers preserve input order', async () => {
+  let active=0,max=0; const seen=[];
+  const result=await mapLimited([4,3,2,1],2,async(value,index)=>{
+    active++; max=Math.max(max,active); seen.push(index);
+    for(let i=0;i<value;i++) await Promise.resolve();
+    active--; return value*2;
+  });
+  assert.deepEqual(result,[8,6,4,2]); assert.deepEqual(seen,[0,1,2,3]); assert.equal(max,2); assert.equal(active,0);
+});
+test('empty and serial inputs', async () => {
+  assert.deepEqual(await mapLimited([],3,async()=>assert.fail('unexpected transform')),[]);
+  assert.deepEqual(await mapLimited([1,2],1,async(x,i)=>x+i),[1,3]);
+});
