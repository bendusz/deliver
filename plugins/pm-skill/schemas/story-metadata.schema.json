{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pm-skill story metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["builder", "touches"],
  "properties": {
    "builder": {
      "type": "string",
      "enum": ["expert-builder", "codex-builder", "auto"]
    },
    "touches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
